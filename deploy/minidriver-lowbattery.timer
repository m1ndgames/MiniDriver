[Unit]
Description=Check the battery often enough to stop before the cell collapses

[Timer]
# Every minute. Two minutes was not enough: one run found the cell healthy and
# the box was dead 118 seconds later. A LiPo falls off a cliff at the bottom of
# its curve, and the check re-reads after a delay before acting, so a long
# interval arrives after the brownout rather than before it.
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=15s
Unit=minidriver-lowbattery.service

[Install]
WantedBy=timers.target
